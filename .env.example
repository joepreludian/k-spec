# Copy to .env.local and set your own values.
# Shared access token for the board; if unset, a random one is generated on every start.
K_SPEC_TOKEN=
# Host name shown in the printed access link (default: localhost). Set it whenever you open
# the board from another machine or a VM host name: in development Next only accepts the
# hot-reload websocket from allow-listed hosts, and without it the page never becomes
# interactive (clicking a card does nothing).
# K_SPEC_HOST=
# Directory the file viewer reads markdown from (default: the working directory).
# K_SPEC_PROJECT_DIR=
